# 240s includes preparation, 180s manipulation, and final drain.
# Only view category (Choreographer), app markers, and FrameTimeline.
# No gfx/scheduler/cpu/input tracing and no process-memory polling.
# 1GiB margin; prior gfx/view 512MiB capture ended after 169s of manipulation.
# Process descriptions are scraped on demand for ftrace PIDs (not periodic counters).
buffers { size_kb: 32768 fill_policy: RING_BUFFER }
buffers { size_kb: 16384 fill_policy: RING_BUFFER }
duration_ms: 240000
write_into_file: true
file_write_period_ms: 1000
flush_period_ms: 1000
max_file_size_bytes: 1073741824
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      atrace_apps: "fr.vueconfort.app.preview"
      atrace_categories: "view"
      drain_period_ms: 250
    }
  }
}
data_sources { config { name: "android.surfaceflinger.frametimeline" target_buffer: 1 } }
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config { scan_all_processes_on_start: true record_thread_names: true }
  }
}

---
import '../styles.css';
import { languages, navItems, routes, ui, type Lang, type Slug } from '../content/site';

interface Props { lang: Lang; title: string; description: string; slug?: Slug; image?: string; noindex?: boolean; }
const { lang, title, description, slug, image = '/og.png', noindex = false } = Astro.props;
const t = ui[lang];
const path = slug ? routes[lang][slug] : '';
const canonical = new URL(`/${lang}/${path ? `${path}/` : ''}`, Astro.site);
const currentSlug = slug;
const documentTitle = title === 'VueConfort'
  ? (lang === 'fr' ? 'VueConfort — confort de lecture sur mobile' : 'VueConfort — mobile reading comfort')
  : `${title} · VueConfort`;
const schema = [{
  '@context':'https://schema.org','@type':'WebSite',name:'VueConfort',url:'https://vueconfort.fr/',
  inLanguage:['fr-FR','en-US'],description
},{
  '@context':'https://schema.org','@type':'Organization',name:'VueConfort',url:'https://vueconfort.fr/',
  email:'contact@vueconfort.fr',logo:'https://vueconfort.fr/icon-512.png'
}];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#075985" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && languages.map((code) => <link rel="alternate" hreflang={code} href={new URL(`/${code}/${slug ? `${routes[code][slug]}/` : ''}`, Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL('/fr/', Astro.site)} />}
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VueConfort" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="VueConfort — confort de lecture sur mobile" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <title>{documentTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      const savedTheme = localStorage.getItem('vueconfort-theme');
      const dark = savedTheme === 'dark' || (!savedTheme && matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href={`/${lang}/`} aria-label="VueConfort — accueil"><span class="brand-mark" aria-hidden="true"></span>VueConfort</a>
        <nav class="desktop-nav" aria-label={t.nav}>
          {navItems[lang].map(([key,label]) => <a href={`/${lang}/${routes[lang][key]}/`} aria-current={currentSlug === key ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="utility">
          <div class="language-switch" aria-label={lang==='fr'?'Choisir la langue':'Choose language'}>
            <a href={`/fr/${slug ? `${routes.fr[slug]}/` : ''}`} lang="fr" hreflang="fr" aria-current={lang==='fr'?'page':undefined}>FR</a><span aria-hidden="true">|</span><a href={`/en/${slug ? `${routes.en[slug]}/` : ''}`} lang="en" hreflang="en" aria-current={lang==='en'?'page':undefined}>EN</a>
          </div>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label={t.theme} title={t.theme}>◐</button>
          <button class="icon-btn menu-btn" id="menu-toggle" type="button" aria-label={t.menu} aria-expanded="false" aria-controls="mobile-menu">☰</button>
        </div>
      </div>
      <nav class="container mobile-nav" id="mobile-menu" aria-label={t.nav}>
        {navItems[lang].map(([key,label]) => <a href={`/${lang}/${routes[lang][key]}/`} aria-current={currentSlug === key ? 'page' : undefined}>{label}</a>)}
        <a href={`/${lang}/${routes[lang].android}/`}>{t.android}</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div><a class="brand" href={`/${lang}/`}><span class="brand-mark" aria-hidden="true"></span>VueConfort</a><p>{t.footer}</p></div>
          <div class="footer-links"><h2>{lang==='fr'?'Explorer':'Explore'}</h2><a href={`/${lang}/${routes[lang].android}/`}>{lang==='fr'?'Bêta Android':'Android beta'}</a><a href={`/${lang}/${routes[lang].fonctionnalites}/`}>{navItems[lang][0][1]}</a><a href={`/${lang}/${routes[lang]['tests-visuels']}/`}>{navItems[lang][1][1]}</a><a href={`/${lang}/${routes[lang].blog}/`}>Blog</a><a href={`/${lang}/${routes[lang].presse}/`}>{lang==='fr'?'Presse':'Press'}</a></div>
          <div class="footer-links"><h2>{t.contact}</h2><a href={`/${lang}/${routes[lang].support}/`}>Support</a><a href={`/${lang}/${routes[lang].contact}/`}>contact@vueconfort.fr</a><a href={`/${lang}/${routes[lang].confidentialite}/`}>{t.privacy}</a><a href={`/${lang}/${routes[lang]['mentions-legales']}/`}>{t.legal}</a></div>
        </div>
        <div class="fine-print"><span>© {new Date().getFullYear()} VueConfort. {t.rights}</span><span>{t.disclaimer}</span></div>
      </div>
    </footer>
    <script is:inline>
      const themeButton = document.getElementById('theme-toggle');
      themeButton?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('vueconfort-theme', next);
      });
      const menuButton = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      menuButton?.addEventListener('click', () => {
        const open = menu?.hasAttribute('open') ?? false;
        menu?.toggleAttribute('open', !open);
        menuButton.setAttribute('aria-expanded', String(!open));
      });
    </script>
  </body>
</html>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { androidBeta, androidStoreUrl, languages, pages, routes, slugs, ui, type Lang, type Slug } from '../../content/site';
export function getStaticPaths(){return languages.flatMap((lang)=>slugs.map((key)=>({params:{lang,slug:routes[lang][key]},props:{lang,key}})));}
const {lang,key}=Astro.props as {lang:Lang;key:Slug};
const page=pages[lang][key],t=ui[lang];
const isAndroid=key==='android', isDownload=key==='telechargement', isContact=key==='contact', isSupport=key==='support';
const android=androidBeta[lang];
const faqSchema = key==='faq' ? {'@context':'https://schema.org','@type':'FAQPage',mainEntity:page.sections.map(s=>({'@type':'Question',name:s.title,acceptedAnswer:{'@type':'Answer',text:s.body}}))} : null;
const androidSchema = isAndroid ? {'@context':'https://schema.org','@type':'SoftwareApplication',name:'VueConfort',operatingSystem:'Android',applicationCategory:'AccessibilityApplication',softwareVersion:'1.0.1',description:page.description} : null;
---
<BaseLayout lang={lang} title={page.title} description={page.description} slug={key}>
  {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {androidSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(androidSchema)} />}
  <section class:list={["page-hero",isAndroid&&"android-hero"]}><div class="container"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="lead">{page.intro}</p>{isAndroid&&<div class="actions">{androidStoreUrl?<a class="button primary" href={androidStoreUrl} rel="noopener">Google Play</a>:<><span class="status-badge" role="status">{android.badge}</span><a class="button secondary" href={`mailto:contact@vueconfort.fr?subject=${encodeURIComponent('Disponibilité Android VueConfort')}`}>{lang==='fr'?'Informations sur le test fermé':'Closed-test information'}</a></>}</div>}</div></section>
  {isAndroid ? <>
    <section class="container android-facts" aria-label={lang==='fr'?'Informations de version':'Version information'}>{android.facts.map(([label,value])=><div><span>{label}</span><strong>{value}</strong></div>)}</section>
    <section class="section soft"><div class="container"><div class="section-head"><h2>{lang==='fr'?'Fonctions disponibles':'Available features'}</h2><p>{lang==='fr'?'Les fonctions ci-dessous correspondent à la version Android 1.0.1 actuellement testée.':'These features match the Android 1.0.1 build currently under test.'}</p></div><div class="grid-4">{android.features.map(([title,items])=><article class="card"><h3>{title}</h3><ul class="check-list">{items.map(item=><li>{item}</li>)}</ul></article>)}</div></div></section>
    <section class="section"><div class="container split-section"><div><p class="eyebrow">{lang==='fr'?'Tests sur appareils':'Device testing'}</p><h2>{lang==='fr'?'Compatibilité de l’appareil':'Device compatibility'}</h2><ul class="check-list">{android.compatibility.map(item=><li>{item}</li>)}</ul><div class="notice">{lang==='fr'?'La compatibilité avec tous les appareils Android n’est pas garantie.':'Compatibility with every Android device is not guaranteed.'}</div></div><div class="card"><h3>{lang==='fr'?'Certaines fonctions dépendent de…':'Some features depend on…'}</h3><ul class="plain-list">{android.dependencies.map(item=><li>{item}</li>)}</ul></div></div></section>
    <section class="section soft"><div class="container split-section"><div><p class="eyebrow">Android AccessibilityService</p><h2>{lang==='fr'?'Installation et autorisations':'Setup and permissions'}</h2><p>{lang==='fr'?'VueConfort utilise un service d’accessibilité pour fournir les fonctions que vous activez :':'VueConfort uses an accessibility service to provide the features you enable:'}</p><ul class="check-list">{android.permissions.map(item=><li>{item}</li>)}</ul></div><div class="benefit-panel"><h2>{lang==='fr'?'Protections intégrées':'Built-in protections'}</h2><ul class="benefit-list">{android.protections.map(item=><li>{item}</li>)}</ul><div class="actions"><a class="button secondary" href={`/${lang}/${routes[lang].confidentialite}/`}>{lang==='fr'?'Lire la politique de confidentialité':'Read the privacy policy'}</a></div></div></div></section>
    <section class="section"><div class="container"><div class="section-head"><h2>{lang==='fr'?'Limites connues':'Known limits'}</h2><p>{lang==='fr'?'VueConfort respecte les protections Android et les capacités exposées par chaque application.':'VueConfort respects Android protections and the capabilities exposed by each app.'}</p></div><ul class="limit-grid">{android.limits.map(item=><li>{item}</li>)}</ul></div></section>
    <section class="section soft"><div class="container"><div class="section-head"><h2>{lang==='fr'?'Captures de l’application':'App screenshots'}</h2><p>{lang==='fr'?'Aucune capture réelle publiable n’est encore présente dans le dépôt. Cette galerie sera complétée avec des images vérifiées, sans donnée personnelle.':'No publishable real screenshot is currently present in the repository. This gallery will be completed with verified images containing no personal data.'}</p></div><div class="screenshot-grid">{android.screenshots.map(item=><div class="screenshot-slot"><span>{lang==='fr'?'Capture prévue':'Planned screenshot'}</span><strong>{item}</strong></div>)}</div></div></section>
    <section class="section"><div class="container android-cta"><span class="status-badge">{lang==='fr'?'Test fermé Google Play':'Closed Google Play test'}</span><h2>{lang==='fr'?'VueConfort 1.0.1 en test fermé':'VueConfort 1.0.1 in closed testing'}</h2><p>{lang==='fr'?'VueConfort est actuellement diffusé uniquement auprès des testeurs autorisés de la piste de test fermé Google Play. L’application n’est pas disponible publiquement.':'VueConfort is currently distributed only to authorized testers through a closed Google Play testing track. The app is not publicly available.'}</p><div class="actions"><a class="button primary" href="https://play.google.com/apps/internaltest/4700839685922170292" target="_blank" rel="noopener noreferrer">{lang==='fr'?'Accéder au test fermé':'Open the closed test'}</a><a class="button secondary" href={`/${lang}/${routes[lang].fonctionnalites}/`}>{t.discover}</a></div></div></section>
  </> : isDownload ? <section class="container download-grid">
    {page.sections.slice(0,2).map((section,i)=><article class="card store-card" id={i===0?'android':'iphone'}><span class="number">{i===0?'ANDROID':'iPHONE'}</span><h2>{section.title}</h2><p>{section.body}</p>{i===0?<div class="actions"><a class="button primary" href={`/${lang}/${routes[lang].android}/`}>{lang==='fr'?'Découvrir la bêta Android':'Explore the Android beta'}</a></div>:<div class="actions"><a class="button primary" href={`mailto:contact@vueconfort.fr?subject=${encodeURIComponent(lang==='fr'?'Être informé du lancement iPhone VueConfort':'Notify me about the VueConfort iPhone launch')}`}>{t.notify}</a></div>}</article>)}
    <article class="notice" style="grid-column:1/-1"><strong>{page.sections[2].title}</strong><br />{page.sections[2].body}</article>
  </section> : <section class="container content-grid">
    {page.sections.map((section,i)=><article class="card"><span class="number">{String(i+1).padStart(2,'0')}</span><h2>{section.title}</h2><p>{section.body}</p>{section.points&&<ul class="points">{section.points.map(point=><li>{point}</li>)}</ul>}</article>)}
  </section>}
  {isContact && <section class="container">
    <form class="contact-form" id="contact-form">
      <div class="field"><label for="contact-type">{lang==='fr'?'Objet':'Topic'}</label><select id="contact-type" name="topic"><option value="contact@vueconfort.fr">{lang==='fr'?'Question générale':'General enquiry'}</option><option value="support@vueconfort.fr">Support</option><option value="privacy@vueconfort.fr">{lang==='fr'?'Confidentialité':'Privacy'}</option></select></div>
      <div class="field"><label for="contact-subject">{lang==='fr'?'Sujet':'Subject'}</label><input id="contact-subject" name="subject" required maxlength="120" autocomplete="off" /></div>
      <div class="field"><label for="contact-message">Message</label><textarea id="contact-message" name="message" required maxlength="3000"></textarea></div>
      <button class="button primary" type="submit">{lang==='fr'?'Ouvrir mon logiciel de messagerie':'Open my email app'}</button>
      <p>{lang==='fr'?'Aucune donnée n’est transmise à ce site. Votre application de messagerie prend le relais.':'No data is sent to this website. Your email application takes over.'}</p>
    </form>
    <script is:inline>
      document.getElementById('contact-form')?.addEventListener('submit',(event)=>{event.preventDefault();const f=event.currentTarget;const to=f.elements.topic.value;const subject=encodeURIComponent(f.elements.subject.value);const body=encodeURIComponent(f.elements.message.value);location.href=`mailto:${to}?subject=${subject}&body=${body}`;});
    </script>
  </section>}
  {isSupport && <section class="container support-contacts" aria-labelledby="support-contacts-title">
    <h2 id="support-contacts-title">{lang==='fr'?'Nous contacter':'Contact us'}</h2>
    <p>{lang==='fr'?'Adresses prévues — leur disponibilité dépend de la configuration de messagerie du domaine.':'Planned addresses — availability depends on the domain email configuration.'}</p>
    <div class="actions"><a class="button secondary" href="mailto:contact@vueconfort.fr">contact@vueconfort.fr</a><a class="button secondary" href="mailto:support@vueconfort.fr">support@vueconfort.fr</a><a class="button secondary" href="mailto:privacy@vueconfort.fr">privacy@vueconfort.fr</a></div>
  </section>}
  {key==='tests-visuels' && <section class="container"><div class="notice">{t.disclaimer}</div></section>}
</BaseLayout>

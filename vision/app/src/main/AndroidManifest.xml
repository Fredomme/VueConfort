<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_vision"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VueConfortVision">
        <activity
            android:name="fr.vueconfort.vision.VisionActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="fr.vueconfort.vision.OpticalActivity"
            android:exported="false"
            android:label="Essai optique · VueConfort Vision" />
        <service
            android:name="fr.vueconfort.vision.VisionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
